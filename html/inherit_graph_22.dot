digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="Pessoa",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classPessoa.html",tooltip="Entidade base que representa uma Pessoa genérica no sistema."];
  Node0 -> Node1 [id="edge7_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="Gerente",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classGerente.html",tooltip="Entidade que representa o usuário administrativo do sistema (Gerente)."];
  Node0 -> Node2 [id="edge8_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Hospede",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classHospede.html",tooltip="Entidade que representa um cliente (Hóspede) do hotel."];
}
